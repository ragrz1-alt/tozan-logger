# Firebase 共通クラウド接続設定 (関係者全員が自動接続されるための設定)
# Webアプリを公開する際、このファイル名を「.env」に変更して各項目にFirebaseの値を貼り付けてください。
# これが設定されていると、関係者（閲覧者）は一切の接続操作・APIキー入力をすることなく、
# URLを開くだけで自動的にクラウドFirestoreと連携されます。

VITE_FIREBASE_API_KEY=AIzaSyDlgnaQ4DlWfsHFQqPqqvrvGm5kd2gFgfo
VITE_FIREBASE_AUTH_DOMAIN=tozan-logger.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tozan-logger
VITE_FIREBASE_STORAGE_BUCKET=tozan-logger.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=266898715515
VITE_FIREBASE_APP_ID=1:266898715515:web:d2397cdc8fd91b704f03de